<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><solid android:color="@color/gold_deep" /><corners android:radius="14dp" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><solid android:color="@color/gold" /><corners android:radius="14dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
