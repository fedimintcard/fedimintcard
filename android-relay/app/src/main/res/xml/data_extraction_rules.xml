<?xml version="1.0" encoding="utf-8"?>
<!--
  The phone's offline store (noBackupFilesDir: the core's pos-core/ and the kit, pos-kit.json) never
  leaves the phone: a restored store would pay the till's pool entries again (the till refuses them,
  pool_entry_reused) and strand those payments (docs/POS-OFFLINE.md). android:allowBackup="false"
  stops cloud backup; on Android 12 and later these rules also keep it out of device-to-device
  transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>
