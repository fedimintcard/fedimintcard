<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical"
        android:background="@drawable/bg_card">
        <TextView android:id="@+id/row_slot" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/dim" android:textSize="14sp" />
        <TextView android:id="@+id/row_note_amount" android:layout_width="0dp" android:layout_weight="2"
            android:layout_height="wrap_content" android:fontFamily="@font/figtree_extrabold"
            android:textColor="@color/ink" android:textSize="18sp" />
        <TextView android:id="@+id/row_note_status" android:layout_width="0dp" android:layout_weight="2"
            android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/mist"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
