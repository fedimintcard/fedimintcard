<?xml version="1.0" encoding="UTF-8"?>
<!--
  build.xml: ant-javacard build of the CAP for a real card (spike step 7).

  Prerequisites:
    1. Apache Ant 1.10+ (brew install ant) and JDK 11+ (JDK 17 used here)
    2. A JavaCard 3.0.5 SDK kit; not downloaded by this file. Clone
         https://github.com/martinpaljak/oracle_javacard_sdks (commit 6a75ec0d6913db236d354f154df7dbc9573d976d)
       and pass -Djc.sdk=/path/to/jc305u4_kit
    3. ant-javacard v26.05.15; downloaded into target/ by this file and checked against a pinned SHA-256,
       or pass -Dant.javacard.jar=/path/to/ant-javacard.jar

  Build:   ant cap -Djc.sdk=/path/to/jc305u4_kit        ->  applet/target/fedimint-card-0.1.cap
  Install: see docs/CAP-BUILD.md (gp: the opener first, then create the card applet from the package)

  3.0.5 is a hard floor: SchnorrHW uses KeyAgreement.ALG_EC_SVDP_DH_PLAIN_XY, which 3.0.4 lacks.
  Pattern from cashucard/javacard (MIT).
-->
<project name="fedimint-card-applet" default="cap" basedir=".">

    <property name="ant.javacard.version" value="v26.05.15"/>
    <property name="ant.javacard.sha256"
              value="14f5e25c07b184e4ec02ee148892c2ea7ad5d7e9db8b91109524df8f7d000589"/>
    <property name="jc.sdk" value="${user.home}/.javacard/sdks/jc305u4_kit"/>
    <property name="src.dir" value="src/main/java"/>
    <property name="target.dir" value="target"/>
    <property name="cap.file" value="${target.dir}/fedimint-card-0.1.cap"/>
    <property name="ant.javacard.jar" value="${target.dir}/ant-javacard-${ant.javacard.version}.jar"/>

    <target name="-check-plugin">
        <available file="${ant.javacard.jar}" property="ant.javacard.present"/>
    </target>

    <target name="download-plugin" depends="-check-plugin" unless="ant.javacard.present">
        <mkdir dir="${target.dir}"/>
        <get src="https://github.com/martinpaljak/ant-javacard/releases/download/${ant.javacard.version}/ant-javacard.jar"
             dest="${ant.javacard.jar}" verbose="true" usetimestamp="true"/>
    </target>

    <target name="-checksum-plugin" depends="download-plugin">
        <checksum file="${ant.javacard.jar}" algorithm="SHA-256"
                  property="${ant.javacard.sha256}" verifyProperty="ant.javacard.verified"/>
        <condition property="ant.javacard.mismatch">
            <not><istrue value="${ant.javacard.verified}"/></not>
        </condition>
    </target>

    <target name="-plugin-mismatch" depends="-checksum-plugin" if="ant.javacard.mismatch">
        <delete file="${ant.javacard.jar}" verbose="true"/>
        <fail>ant-javacard.jar does not match the pinned SHA-256 and has been deleted. Re-run to download again, or fix the pin if you bumped the version.</fail>
    </target>

    <target name="setup" depends="-plugin-mismatch">
        <taskdef name="javacard" classname="pro.javacard.ant.JavaCard" classpath="${ant.javacard.jar}"/>
        <mkdir dir="${target.dir}"/>
    </target>

    <!--
      AIDs (see README): package F0 "FMCARD" (7 bytes); applets are package + one byte.
        Package AID : F0 46 4D 43 41 52 44
        Opener  AID : F0 46 4D 43 41 52 44 4D   (instantiated first; see Opener.java)
        Applet  AID : F0 46 4D 43 41 52 44 01   (what hosts SELECT)
    -->
    <target name="cap" depends="setup" description="Build the CAP (JavaCard 3.0.5)">
        <javacard>
            <cap jckit="${jc.sdk}" targetsdk="${jc.sdk}" sources="${src.dir}"
                 package="io.github.bobodread876.fedimintcard.applet" version="0.1"
                 aid="F0:46:4D:43:41:52:44" output="${cap.file}">
                <applet class="io.github.bobodread876.fedimintcard.applet.Opener"
                        aid="F0:46:4D:43:41:52:44:4D"/>
                <applet class="io.github.bobodread876.fedimintcard.applet.FedimintCardApplet"
                        aid="F0:46:4D:43:41:52:44:01"/>
            </cap>
        </javacard>
        <echo message="CAP file: ${cap.file} (install the opener first; see docs/CAP-BUILD.md)"/>
    </target>

    <target name="clean" description="Remove build artefacts">
        <delete dir="${target.dir}"/>
    </target>
</project>
